<panel>
  <div name="stats-root" background-color="#000a15" border-radius="20" padding="20" width="360" flex-direction="column" align-items="center" gap="8">
    <div name="stats-title" font-size="22" color="#00ffff" font-weight="bold">CAREER STATS</div>
    <div name="stats-list" flex-direction="column" gap="6" width="300">
      <div name="row1" flex-direction="row" justify-content="space-between">
        <div name="l1" font-size="13" color="#888888">Games Played</div>
        <div name="stat-games" font-size="13" color="#00ffff">0</div>
      </div>
      <div name="row2" flex-direction="row" justify-content="space-between">
        <div name="l2" font-size="13" color="#888888">Barrels Smashed</div>
        <div name="stat-smashed" font-size="13" color="#00ffff">0</div>
      </div>
      <div name="row3" flex-direction="row" justify-content="space-between">
        <div name="l3" font-size="13" color="#888888">Barrels Jumped</div>
        <div name="stat-jumped" font-size="13" color="#00ffff">0</div>
      </div>
      <div name="row4" flex-direction="row" justify-content="space-between">
        <div name="l4" font-size="13" color="#888888">Levels Cleared</div>
        <div name="stat-levels" font-size="13" color="#00ffff">0</div>
      </div>
      <div name="row5" flex-direction="row" justify-content="space-between">
        <div name="l5" font-size="13" color="#888888">Deaths</div>
        <div name="stat-deaths" font-size="13" color="#ff4444">0</div>
      </div>
      <div name="row6" flex-direction="row" justify-content="space-between">
        <div name="l6" font-size="13" color="#888888">Hammers Used</div>
        <div name="stat-hammers" font-size="13" color="#ffaa00">0</div>
      </div>
      <div name="row7" flex-direction="row" justify-content="space-between">
        <div name="l7" font-size="13" color="#888888">Best Score</div>
        <div name="stat-best-score" font-size="13" color="#ffaa00">0</div>
      </div>
      <div name="row8" flex-direction="row" justify-content="space-between">
        <div name="l8" font-size="13" color="#888888">Best Level</div>
        <div name="stat-best-level" font-size="13" color="#ffaa00">0</div>
      </div>
      <div name="row9" flex-direction="row" justify-content="space-between">
        <div name="l9" font-size="13" color="#888888">Best Combo</div>
        <div name="stat-best-combo" font-size="13" color="#ff00ff">0</div>
      </div>
    </div>
    <div name="btn-stats-back" font-size="14" color="#888888" hover-opacity="0.7">Back</div>
  </div>
</panel>
