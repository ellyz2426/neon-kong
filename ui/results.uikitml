<panel>
  <div name="results-root" background-color="#000a15" border-radius="20" padding="24" width="400" flex-direction="column" align-items="center" gap="12">
    <div name="results-title" font-size="28" color="#ff4444" font-weight="bold">GAME OVER</div>
    <div name="spacer" height="6"></div>
    <div name="final-score" font-size="22" color="#00ffff">Score: 0</div>
    <div name="final-level" font-size="16" color="#ffaa00">Level: 1</div>
    <div name="final-barrels" font-size="14" color="#ff88ff">Smashed: 0  Jumped: 0</div>
    <div name="final-combo" font-size="14" color="#ff00ff"></div>
    <div name="final-best" font-size="14" color="#888888">Best: 0</div>
    <div name="new-high" font-size="16" color="#ffaa00" font-weight="bold"></div>
    <div name="spacer2" height="8"></div>
    <div name="btn-retry" font-size="18" color="#00ffff" background-color="#003344" border-radius="10" padding="10" width="260" hover-opacity="0.7">PLAY AGAIN</div>
    <div name="btn-menu" font-size="18" color="#888888" background-color="#222222" border-radius="10" padding="10" width="260" hover-opacity="0.7">MAIN MENU</div>
  </div>
</panel>
