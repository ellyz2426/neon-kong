<panel>
  <div name="menu-root" background-color="#000a15" border-radius="20" padding="24" width="420" flex-direction="column" align-items="center" gap="12">
    <div name="title" font-size="32" color="#00ffff" font-weight="bold">NEON KONG VR</div>
    <div name="subtitle" font-size="14" color="#0088aa">Donkey Kong Climbing Arcade</div>
    <div name="high-score" font-size="14" color="#ffaa00">Best: 0</div>
    <div name="spacer" height="8"></div>
    <div name="btn-start" font-size="18" color="#00ffff" background-color="#003344" border-radius="10" padding="10" width="280" hover-opacity="0.7">ARCADE MODE</div>
    <div name="btn-speed" font-size="18" color="#00ff88" background-color="#003322" border-radius="10" padding="10" width="280" hover-opacity="0.7">SPEED MODE (120s)</div>
    <div name="btn-zen" font-size="18" color="#ff88ff" background-color="#330033" border-radius="10" padding="10" width="280" hover-opacity="0.7">ZEN MODE (99 lives)</div>
    <div name="btn-challenge" font-size="18" color="#ffaa00" background-color="#332200" border-radius="10" padding="10" width="280" hover-opacity="0.7">CHALLENGE (200 moves)</div>
    <div name="spacer2" height="4"></div>
    <div name="btn-settings" font-size="14" color="#888888" hover-opacity="0.7">Settings</div>
    <div name="btn-tutorial" font-size="14" color="#888888" hover-opacity="0.7">How to Play</div>
  </div>
</panel>
