<panel>
  <div name="ach-root" background-color="#000a15" border-radius="20" padding="20" width="380" flex-direction="column" align-items="center" gap="8">
    <div name="ach-title" font-size="22" color="#ffaa00" font-weight="bold">ACHIEVEMENTS</div>
    <div name="ach-count" font-size="12" color="#888888">0/25</div>
    <div name="ach-list" flex-direction="column" gap="6" width="340">
      <div name="ach-row-0" flex-direction="column" gap="2">
        <div name="ach-0" font-size="14" color="#00ffff"></div>
        <div name="ach-desc-0" font-size="11" color="#666666"></div>
      </div>
      <div name="ach-row-1" flex-direction="column" gap="2">
        <div name="ach-1" font-size="14" color="#00ffff"></div>
        <div name="ach-desc-1" font-size="11" color="#666666"></div>
      </div>
      <div name="ach-row-2" flex-direction="column" gap="2">
        <div name="ach-2" font-size="14" color="#00ffff"></div>
        <div name="ach-desc-2" font-size="11" color="#666666"></div>
      </div>
      <div name="ach-row-3" flex-direction="column" gap="2">
        <div name="ach-3" font-size="14" color="#00ffff"></div>
        <div name="ach-desc-3" font-size="11" color="#666666"></div>
      </div>
      <div name="ach-row-4" flex-direction="column" gap="2">
        <div name="ach-4" font-size="14" color="#00ffff"></div>
        <div name="ach-desc-4" font-size="11" color="#666666"></div>
      </div>
    </div>
    <div name="ach-nav" flex-direction="row" gap="12" align-items="center">
      <div name="btn-prev" font-size="14" color="#00ffff" hover-opacity="0.7">Prev</div>
      <div name="ach-page" font-size="12" color="#888888">1/5</div>
      <div name="btn-next" font-size="14" color="#00ffff" hover-opacity="0.7">Next</div>
    </div>
    <div name="btn-ach-back" font-size="14" color="#888888" hover-opacity="0.7">Back</div>
  </div>
</panel>
